{
  "name": "stockpulse",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "web:dev": "pnpm --filter pulse-web dev",
    "web:build": "pnpm --filter pulse-web build",
    "web:preview": "pnpm --filter pulse-web preview",
    "web:typecheck": "pnpm --filter pulse-web typecheck",
    "web:lint": "pnpm --filter pulse-web lint",
