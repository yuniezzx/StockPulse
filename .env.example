# StockPulse 环境变量样板
# 复制为 .env（仓库根目录）后填入真实值。.env 不进 git。
# 命名前缀规则见 docs/naming-conventions.md §5

# ---- Database (pulse-core + pulse-api 共用) ----
# 本机开发：可直接用 postgres superuser，或建专用 SUPERUSER 用户
DB_NAME=stockpulse
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/stockpulse

# ---- API (pulse-api Fastify) ----
NODE_ENV=development
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173
JWT_SECRET=your_jwt_secret_here_min_16_chars

# ---- Tushare (pulse-core 数据同步) ----
TUSHARE_API_URL=http://tsy.xiaodefa.cn
TUSHARE_TOKEN=your_tushare_token_here

# ---- pulse-core ----
CORE_LOG_LEVEL=INFO
